{
  "name": "pokemon-battle-rooms-utp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx concurrently -k \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite dev",
    "dev:server": "bun --hot src/server/index.ts",
    "build": "vite build && bunx tsc --noEmit",
    "start": "bunx concurrently -k \"node start-server.mjs\" \"bun src/server/index.ts\"",
    "seed": "bun src/scripts/import-pokemon.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "hono": "^4.10.3",
    "lucide-react": "^0.554.0",
    "mongodb": "^6.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "bun-types": "^1.3.11",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
